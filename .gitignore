# Volatile now-file — local state, never committed (canon.pulse-heartbeat).
pulse.md
pulse*
_tester/

# Research report output — ephemeral by default (persist: ephemeral in scope README).
# Canonical scopes negate their folder with !raw.research/<scope>/report/ in this file.
raw.research/*/report/*
!raw.research/*/report/.gitkeep
!raw.research/agent-docs/report/
!raw.research/nature/report/

# Photo inboxes — binary assets, never committed. processed/ subfolder follows same rule.
raw.research/*/photos/*
!raw.research/*/photos/.gitkeep

